# ===== Database =====
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cinex_db
MYSQL_USER=cinex
MYSQL_PASSWORD=cinex123

# ===== Backend (Spring Boot) =====
SPRING_PROFILES_ACTIVE=prod
APP_JWT_SECRET=cinex-secret-key-change-in-production
APP_JWT_EXPIRATION=86400000

# ===== TMDB (kho dữ liệu phim) =====
TMDB_API_KEY=your-tmdb-api-key

# ===== Frontend =====
VITE_API_URL=http://localhost:8080/api

# ===== Nginx / SSL =====
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem

# ===== Server (for CD) =====
SERVER_HOST=your-server-ip
SERVER_USER=deploy
SSH_PRIVATE_KEY=your-ssh-private-key
HEALTH_CHECK_URL=https://your-domain.com/actuator/health