# ===== Database =====
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cinex_db
MYSQL_USER=cinex
MYSQL_PASSWORD=cinex123

# ===== Backend (Spring Boot) =====
SPRING_PROFILES_ACTIVE=prod
APP_JWT_SECRET=cinex-secret-key-change-in-production
APP_JWT_EXPIRATION=3600000

# ===== Mail (SMTP Gmail - gửi OTP quên mật khẩu) =====
# MAIL_USERNAME: email dùng để gửi, ví dụ: your-email@gmail.com
# MAIL_PASSWORD: mật khẩu ứng dụng 16 ký tự của Gmail (sau khi bật Xác thực 2 bước)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== TMDB (kho dữ liệu phim) =====
TMDB_API_KEY=your-tmdb-api-key

# ===== YouTube Data API v3 (trailer phim) =====
# Tạo key tại Google Cloud Console (APIs & Services > Credentials), bật YouTube Data API v3
# Chỉ lưu trong .env/GitHub Secret, không commit. Key không bao giờ vào frontend.
YOUTUBE_API_KEY=your-youtube-api-key

# ===== Google OAuth (đăng nhập bằng Google) =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== Frontend =====
VITE_API_URL=http://localhost:8080/api

# ===== NVIDIA AI (chat box + mô tả ảnh) =====
# Tạo key tại https://build.nvidia.com, chỉ lưu trong .env/GitHub Secret, không commit
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# ===== Nginx / SSL =====
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem

# ===== Server (for CD) =====
SERVER_HOST=your-server-ip
SERVER_USER=deploy
SSH_PRIVATE_KEY=your-ssh-private-key
HEALTH_CHECK_URL=https://your-domain.com/actuator/health